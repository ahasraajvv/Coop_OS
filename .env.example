# CoopOS Environment Configuration

# Set to True for development, False for production
DEBUG=True

# Security Secret Key (generate a random string for production)
SECRET_KEY=django-insecure-coopos-farm-workstation-secure-key

# Database Configuration:
# When DATABASE_URL is set, CoopOS automatically connects to PostgreSQL.
# When DATABASE_URL is left empty or commented out, it automatically uses local SQLite.
#
# Example for Local PostgreSQL:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/coopos
#
# Example for Cloud PostgreSQL (Neon / Supabase / Render / Railway):
# DATABASE_URL=postgresql://user:password@ep-cool-flock.us-east-2.aws.neon.tech/coopos?sslmode=require
